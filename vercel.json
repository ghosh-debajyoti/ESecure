{
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{frontend/**,public/**,tests/**,data/**,scripts/**,*.eml,*.pdf,test_*.py,*.db,docs/**,train_model.py,generate_*.py}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
