# VERCEL DEPLOYMENT CONFIGURATION

# IMPORTANT: Vercel's filesystem is ephemeral. SQLite will lose data across function invocations.
# You MUST use a persistent PostgreSQL database (e.g., Neon, Supabase, Vercel Postgres).
DATABASE_URL=postgresql://user:password@host/database

# IMPORTANT: The Transformers library must use /tmp for caching, as Vercel's root filesystem is read-only.
TRANSFORMERS_CACHE=/tmp

# Optionally override the frontend API base URL (Default uses relative `/api` on Vercel)
# VITE_API_URL=https://your-domain.vercel.app
